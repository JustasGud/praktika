<Window x:Class="UtilityBillingSystem.UI.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komunalinių paslaugų sistema" Height="560" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBg}" Padding="18" Grid.Column="0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Komunalinių paslaugų" Foreground="{StaticResource SidebarFg}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="valdymo sistema" Foreground="{StaticResource SidebarFg}" Opacity="0.85"/>

                    <Border Margin="0,14,0,0" Background="#0B1220" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource SidebarFg}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource SidebarFg}" Opacity="0.75"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Meniu" Foreground="{StaticResource SidebarFg}" Opacity="0.85" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding MenuItems}"
                             SelectedItem="{Binding SelectedMenuItem}"
                             Style="{StaticResource SidebarListBoxStyle}"
                             Margin="0,0,0,12"/>

                    <Button Content="Atsijungti" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"/>
                    <Button Content="Išeiti" Command="{Binding ExitCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Border Grid.Column="1" Margin="16" Background="{StaticResource CardBg}" CornerRadius="12" Padding="16">
            <ContentControl Content="{Binding CurrentContent}"/>
        </Border>
    </Grid>
</Window>
