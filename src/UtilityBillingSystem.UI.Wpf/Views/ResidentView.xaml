<UserControl x:Class="UtilityBillingSystem.UI.Wpf.Views.ResidentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Mano paslaugos" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Peržiūrėkite savo bendrijai priskirtas paslaugas ir galiojančias kainas." Style="{StaticResource HintText}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="Paieška:" Margin="0,0,8,0"/>
                        <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Atnaujinti" Width="120" Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <TextBlock Grid.Row="1" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredServices}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Paslauga" Binding="{Binding ServiceName}" Width="*"/>
                        <DataGridTextColumn Header="Kaina" Binding="{Binding Price}" Width="120"/>
                        <DataGridTextColumn Header="Valiuta" Binding="{Binding Currency}" Width="80"/>
                        <DataGridTextColumn Header="Galioja nuo" Binding="{Binding EffectiveFrom}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
